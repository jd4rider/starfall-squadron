{
  "name": "starfall-squadron",
  "private": true,
  "version": "1.0.4",
  "description": "Starfall Squadron — a portrait-first 3D arcade space shooter built with Three.js.",
  "author": "jd4rider",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:missions": "tsx scripts/validate-missions.ts",
    "check": "npm run test && npm run check:missions && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
